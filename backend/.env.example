# Environment configuration for AuraStudy FastAPI Backend
PROJECT_NAME="AuraStudy"
API_V1_STR="/api"

# Database Configuration (MySQL)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="aurastudy_user"
DB_PASSWORD="aurastudy_password"
DB_NAME="aurastudy_db"

# JWT Security
SECRET_KEY="your-super-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days

# AI Integration
GEMINI_API_KEY="your-gemini-api-key"

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15
